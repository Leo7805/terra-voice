# ─────────────────────────────────────────────────────────────────────────────
# Terra Voice — .gitignore
# Monorepo: backend/ = ASP.NET Core (TerraVoice), frontend/ = Vite + React + TS
# ─────────────────────────────────────────────────────────────────────────────

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Editor / IDE ────────────────────────────────────────────────────────────
.vs/
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ── Secrets / env ───────────────────────────────────────────────────────────
# Local secrets only — keep .env.example committed
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Azure Speech keys, connection strings with creds, etc.
*.pfx
*.p12
*.key
secrets.json
appsettings.Local.json
appsettings.*.Local.json

# ── Backend: .NET / ASP.NET Core ────────────────────────────────────────────
# Build output
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
TestResults/
*.dll
*.exe
*.pdb
*.user

# NuGet / restore artifacts
*.nupkg
*.snupkg
.nuget/
packages/
project.lock.json
project.assets.json

# Rider / ReSharper / dotnet user-secrets
.idea/
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
*.suo
*.userosscache
*.sln.docstates

# Local SQLite databases (runtime data, not source)
*.db
*.db-shm
*.db-wal
Data/*.db
Data/*.db-shm
Data/*.db-wal

# Publish output
publish/
wwwroot/dist/

# ── Frontend: Node / Vite / React / TypeScript ──────────────────────────────
node_modules/
dist/
dist-ssr/
build/
coverage/
.cache/
.parcel-cache/
.turbo/
.next/
.nuxt/
.vite/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Optional npm/nycrc-style tooling noise
.nyc_output/
.eslintcache

# TypeScript build info (regenerable)
*.tsbuildinfo

# Vite/Rollup source maps from production builds
*.map

# ── Misc project artefacts ──────────────────────────────────────────────────
# Frontend already on port — kill on commit
*.pid
*.seed
*.pid.lock
